APP_NAME=Bhagavatha Puranam
APP_ENV=development
DATABASE_URL=sqlite:///./data/bhagavatha.db
STORAGE_DIR=./storage

# Default image provider for this product.
IMAGE_PROVIDER=grok-imagine
GROK_API_KEY=
GROK_IMAGE_MODEL=grok-imagine-image
GROK_CHAT_MODEL=grok-4-1-fast

# Mythology mode permits devotional/epic non-graphic battle scenes.
CONTENT_DOMAIN=bhagavatham
MYTHOLOGY_MODE=true

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
